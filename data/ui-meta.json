    {
     "name": "size",
     "type": "number",
     "default": "36",
     "desc": "Tamaño en píxeles"
    },
    {
     "name": "shape",
     "type": "'circle' | 'square'",
     "default": "'circle'",
     "desc": "Forma"
    },
    {
     "name": "status",
     "type": "'' | 'online' | 'busy' | 'away'",
     "default": "''",
     "desc": "Punto de estado"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"img\" con aria-label igual al nombre."
  },
  {
   "id": "divider",
   "name": "Divider",
   "tag": "ui-divider",
   "group": "Básicos",
   "summary": "Línea separadora, con texto opcional.",
   "inputs": [
    {
     "name": "label",
     "type": "string",
     "default": "''",
     "desc": "Texto centrado sobre la línea"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"separator\"."
  },
  {
   "id": "card",
   "name": "Card",
   "tag": "ui-card",
   "group": "Básicos",
   "summary": "Contenedor con título y pie opcionales.",
   "inputs": [
    {
     "name": "title",
     "type": "string",
     "default": "''",
     "desc": "Título de la cabecera"
    }
   ],
   "outputs": [],
   "slots": [
    {
     "name": "(por defecto)",
     "desc": "Cuerpo"

{
 "groups": [
  "Básicos",
  "Formularios",
  "Navegación",
  "Superposiciones",
  "Datos"
 ],
 "components": [
  {
   "id": "button",
   "name": "Button",
   "tag": "ui-button",
   "group": "Básicos",
   "summary": "Botón con variantes, tamaños, estado de carga y ancho completo.",
   "inputs": [
    {
     "name": "variant",
     "type": "'default' | 'primary' | 'accent' | 'danger' | 'ghost'",
     "default": "'default'",
     "desc": "Estilo visual"
    },
    {
     "name": "size",
     "type": "'sm' | 'md' | 'lg'",
     "default": "'md'",
     "desc": "Tamaño"
    },
    {
     "name": "disabled",
     "type": "boolean",
     "default": "false",
     "desc": "Deshabilita el botón"
    },
    {
     "name": "loading",
     "type": "boolean",
     "default": "false",
     "desc": "Muestra un spinner, deshabilita y marca aria-busy"
    },
    {
     "name": "type",
     "type": "'button' | 'submit' | 'reset'",
     "default": "'button'",
     "desc": "Tipo del botón nativo"
    },
    {
     "name": "block",
     "type": "boolean",
     "default": "false",
     "desc": "Ocupa todo el ancho"
    }
   ],
   "outputs": [],
   "slots": [
    {
     "name": "(por defecto)",
     "desc": "Contenido del botón"
    }
   ],
   "a11y": "Es un <button> nativo: foco, Enter y Espacio funcionan solos. Con loading=\"true\" expone aria-busy."
  },
  {
   "id": "badge",
   "name": "Badge",
   "tag": "ui-badge",
   "group": "Básicos",
   "summary": "Etiqueta corta para estados y contadores.",
   "inputs": [
    {
     "name": "variant",
     "type": "'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info'",
     "default": "'default'",
     "desc": "Color"
    },
    {
     "name": "dot",
     "type": "boolean",
     "default": "false",
     "desc": "Añade un punto delante"
    }
   ],
   "outputs": [],
   "slots": [
    {
     "name": "(por defecto)",
     "desc": "Texto"
    }
   ],
   "a11y": "Es texto: si el color transmite significado, di el estado también con palabras."
  },
  {
   "id": "chip",
   "name": "Chip",
   "tag": "ui-chip",
   "group": "Básicos",
   "summary": "Etiqueta que se puede quitar (filtros, destinatarios).",
   "inputs": [
    {
     "name": "variant",
     "type": "'default' | 'primary'",
     "default": "'default'",
     "desc": "Estilo"
    },
    {
     "name": "removable",
     "type": "boolean",
     "default": "false",
     "desc": "Muestra el botón para quitarla"
    },
    {
     "name": "removeLabel",
     "type": "string",
     "default": "'Quitar'",
     "desc": "Etiqueta accesible del botón"
    }
   ],
   "outputs": [
    {
     "name": "removed",
     "payload": "void",
     "desc": "Se pulsó el botón de quitar"
    }
   ],
   "slots": [
    {
     "name": "(por defecto)",
     "desc": "Texto"
    }
   ],
   "a11y": "El botón de quitar tiene aria-label (configurable)."
  },
  {
   "id": "avatar",
   "name": "Avatar",
   "tag": "ui-avatar",
   "group": "Básicos",
   "summary": "Imagen o iniciales de una persona, con indicador de estado.",
   "inputs": [
    {
     "name": "name",
     "type": "string",
     "default": "''",
     "desc": "Nombre: da las iniciales y la etiqueta accesible"
    },
    {

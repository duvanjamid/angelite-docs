    {
     "name": "footer",
     "desc": "Pie (slot=\"footer\")"
    }
   ],
   "a11y": "Es un contenedor neutro; el título es un h4."
  },
  {
   "id": "alert",
   "name": "Alert",
   "tag": "ui-alert",
   "group": "Básicos",
   "summary": "Aviso en línea, con título y cierre opcionales.",
   "inputs": [
    {
     "name": "type",
     "type": "'info' | 'success' | 'warning' | 'error'",
     "default": "'info'",
     "desc": "Tipo"
    },
    {
     "name": "title",
     "type": "string",
     "default": "''",
     "desc": "Título en negrita"
    },
    {
     "name": "dismissible",
     "type": "boolean",
     "default": "false",
     "desc": "Muestra el botón de cerrar"
    },
    {
     "name": "closeLabel",
     "type": "string",
     "default": "'Cerrar'",
     "desc": "Etiqueta accesible del botón"
    }
   ],
   "outputs": [
    {
     "name": "closed",
     "payload": "void",
     "desc": "Se cerró el aviso"
    }
   ],
   "slots": [
    {
     "name": "(por defecto)",
     "desc": "Mensaje"
    }
   ],
   "a11y": "error y warning usan role=\"alert\" (se anuncian al instante); info y success, role=\"status\"."
  },
  {
   "id": "spinner",
   "name": "Spinner",
   "tag": "ui-spinner",
   "group": "Básicos",
   "summary": "Indicador de carga.",
   "inputs": [
    {
     "name": "label",
     "type": "string",
     "default": "'Cargando'",
     "desc": "Texto para lectores de pantalla"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"status\" con aria-label; la animación se ralentiza con prefers-reduced-motion."
  },
  {
   "id": "progress",
   "name": "Progress",
   "tag": "ui-progress",
   "group": "Básicos",
   "summary": "Barra de progreso determinada o indeterminada.",
   "inputs": [
    {
     "name": "value",
     "type": "number",
     "default": "0",
     "desc": "Valor actual"
    },
    {
     "name": "max",
     "type": "number",
     "default": "100",
     "desc": "Valor máximo"
    },
    {
     "name": "label",
     "type": "string",
     "default": "''",
     "desc": "Texto sobre la barra (con porcentaje)"
    },
    {
     "name": "variant",
     "type": "'primary' | 'success' | 'warning' | 'danger'",
     "default": "'primary'",
     "desc": "Color"
    },
    {
     "name": "indeterminate",
     "type": "boolean",
     "default": "false",
     "desc": "Animación continua sin valor"
    }
   ],
   "outputs": [],
   "slots": [],

{
 "groups": [
  "Basics",
  "Forms",
  "Navigation",
  "Overlays",
  "Data"
 ],
 "components": [
  {
   "id": "button",
   "name": "Button",
   "tag": "ui-button",
   "group": "Basics",
   "summary": "Button with variants, sizes, a loading state and full width.",
   "inputs": [
    {
     "name": "variant",
     "type": "'default' | 'primary' | 'accent' | 'danger' | 'ghost'",
     "default": "'default'",
     "desc": "Visual style"
    },
    {
     "name": "size",
     "type": "'sm' | 'md' | 'lg'",
     "default": "'md'",
     "desc": "Size"
    },
    {
     "name": "disabled",
     "type": "boolean",
     "default": "false",
     "desc": "Disables the button"
    },
    {
     "name": "loading",
     "type": "boolean",
     "default": "false",
     "desc": "Shows a spinner, disables the button and sets aria-busy"
    },
    {
     "name": "type",
     "type": "'button' | 'submit' | 'reset'",
     "default": "'button'",
     "desc": "Type of the native button"
    },
    {
     "name": "block",
     "type": "boolean",
     "default": "false",
     "desc": "Takes the full width"
    }
   ],
   "outputs": [],
   "slots": [
    {
     "name": "(default)",
     "desc": "Button content"
    }
   ],
   "a11y": "A native <button>: focus, Enter and Space work on their own. With loading=\"true\" it exposes aria-busy."
  },
  {
   "id": "badge",
   "name": "Badge",
   "tag": "ui-badge",
   "group": "Basics",
   "summary": "Short label for statuses and counters.",
   "inputs": [
    {
     "name": "variant",
     "type": "'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info'",
     "default": "'default'",
     "desc": "Color"
    },
    {
     "name": "dot",
     "type": "boolean",
     "default": "false",
     "desc": "Adds a dot in front"
    }
   ],
   "outputs": [],
   "slots": [
    {
     "name": "(default)",
     "desc": "Text"
    }
   ],
   "a11y": "It is plain text: if the color carries meaning, say the status in words too."
  },
  {
   "id": "chip",
   "name": "Chip",
   "tag": "ui-chip",
   "group": "Basics",
   "summary": "Label that can be removed (filters, recipients).",
   "inputs": [
    {
     "name": "variant",
     "type": "'default' | 'primary'",
     "default": "'default'",
     "desc": "Style"
    },
    {
     "name": "removable",
     "type": "boolean",
     "default": "false",
     "desc": "Shows the remove button"
    },
    {
     "name": "removeLabel",
     "type": "string",
     "default": "'Remove'",
     "desc": "Accessible label of the button"
    }
   ],
   "outputs": [
    {
     "name": "removed",
     "payload": "void",
     "desc": "The remove button was pressed"
    }
   ],
   "slots": [
    {
     "name": "(default)",
     "desc": "Text"
    }
   ],
   "a11y": "The remove button has an aria-label (configurable)."
  },
  {
   "id": "avatar",
   "name": "Avatar",
   "tag": "ui-avatar",
   "group": "Basics",
   "summary": "Image or initials of a person, with a status indicator.",
   "inputs": [
    {
     "name": "name",
     "type": "string",
     "default": "''",
     "desc": "Name: gives the initials and the accessible label"
    },
    {
     "name": "src",
     "type": "string",
     "default": "''",
     "desc": "Image URL (sanitized like any src)"
    },
    {
     "name": "size",
     "type": "number",
     "default": "36",
     "desc": "Size in pixels"
    },
    {
     "name": "shape",
     "type": "'circle' | 'square'",
     "default": "'circle'",
     "desc": "Shape"
    },
    {
     "name": "status",
     "type": "'' | 'online' | 'busy' | 'away'",
     "default": "''",
     "desc": "Status dot"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"img\" with an aria-label equal to the name."
  },
  {
   "id": "divider",
   "name": "Divider",
   "tag": "ui-divider",
   "group": "Basics",
   "summary": "Separator line, with optional text.",
   "inputs": [
    {
     "name": "label",
     "type": "string",
     "default": "''",
     "desc": "Text centered over the line"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"separator\"."
  },
  {
   "id": "card",
   "name": "Card",
   "tag": "ui-card",
   "group": "Basics",
   "summary": "Container with an optional title and footer.",
   "inputs": [
    {
     "name": "title",
     "type": "string",
     "default": "''",
     "desc": "Header title"

   ],
   "outputs": [],
   "slots": [
    {
     "name": "(default)",
     "desc": "Body"
    },
    {
     "name": "footer",
     "desc": "Footer (slot=\"footer\")"
    }
   ],
   "a11y": "A neutral container; the title is an h4."
  },
  {
   "id": "alert",
   "name": "Alert",
   "tag": "ui-alert",
   "group": "Basics",
   "summary": "Inline notice, with an optional title and close button.",
   "inputs": [
    {
     "name": "type",
     "type": "'info' | 'success' | 'warning' | 'error'",
     "default": "'info'",
     "desc": "Type"
    },
    {
     "name": "title",
     "type": "string",
     "default": "''",
     "desc": "Bold title"
    },
    {
     "name": "dismissible",
     "type": "boolean",
     "default": "false",
     "desc": "Shows the close button"
    },
    {
     "name": "closeLabel",
     "type": "string",
     "default": "'Close'",
     "desc": "Accessible label of the button"
    }
   ],
   "outputs": [
    {
     "name": "closed",
     "payload": "void",
     "desc": "The notice was closed"
    }
   ],
   "slots": [
    {
     "name": "(default)",
     "desc": "Message"
    }
   ],
   "a11y": "error and warning use role=\"alert\" (announced at once); info and success use role=\"status\"."
  },
  {
   "id": "spinner",
   "name": "Spinner",
   "tag": "ui-spinner",
   "group": "Basics",
   "summary": "Loading indicator.",
   "inputs": [
    {
     "name": "label",
     "type": "string",
     "default": "'Loading'",
     "desc": "Text for screen readers"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"status\" with an aria-label; the animation slows down with prefers-reduced-motion."
  },
  {
   "id": "progress",
   "name": "Progress",
   "tag": "ui-progress",
   "group": "Basics",
   "summary": "Determinate or indeterminate progress bar.",
   "inputs": [
    {
     "name": "value",
     "type": "number",
     "default": "0",
     "desc": "Current value"
    },
    {
     "name": "max",
     "type": "number",
     "default": "100",
     "desc": "Maximum value"
    },
    {
     "name": "label",
     "type": "string",
     "default": "''",
     "desc": "Text above the bar (with the percentage)"
    },
    {
     "name": "variant",
     "type": "'primary' | 'success' | 'warning' | 'danger'",
     "default": "'primary'",
     "desc": "Color"
    },
    {
     "name": "indeterminate",
     "type": "boolean",
     "default": "false",
     "desc": "Continuous animation without a value"
    }
   ],
   "outputs": [],
   "slots": [],
   "a11y": "role=\"progressbar\" with aria-valuenow/min/max; in indeterminate mode there is no aria-valuenow."
  },
  {
   "id": "skeleton",
   "name": "Skeleton",
   "tag": "ui-skeleton",
   "group": "Basics",
   "summary": "Placeholder while content loads.",
   "inputs": [
    {
     "name": "height",
     "type": "number",
     "default": "16",
     "desc": "Height in pixels"
    },
    {
     "name": "width",
     "type": "string",
     "default": "'100%'",
     "desc": "CSS width"
    },
    {
     "name": "circle",
     "type": "boolean",
     "default": "false",
     "desc": "Circular shape"
    }
   ],
   "outputs": [],
   "slots": [],

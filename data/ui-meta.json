     "default": "''",
     "desc": "Hint"
    },
    {
     "name": "error",
     "type": "string",
     "default": "''",
     "desc": "Error message (replaces the hint)"
    },
    {
     "name": "name",
     "type": "string",
     "default": "''",
     "desc": "The name attribute"
    },
    {
     "name": "disabled",
     "type": "boolean",
     "default": "false",
     "desc": "Disabled"
